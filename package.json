{
    "name": "@bm1549/remote-mcp-cloudflare",
    "version": "0.1.1",
    "type": "module",
    "description": "Library for wrapping a stdio MCP server in a Cloudflare Worker with Google OAuth + email allowlist. Exposes the server as a remote MCP endpoint for Claude Desktop / mobile.",
    "license": "MIT",
    "author": "Brian Marks <bmarks1056@gmail.com>",
    "homepage": "https://github.com/bm1549/remote-mcp-cloudflare#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bm1549/remote-mcp-cloudflare.git"
    },
    "bugs": {
        "url": "https://github.com/bm1549/remote-mcp-cloudflare/issues"
    },
    "keywords": [
        "mcp",
        "model-context-protocol",
        "cloudflare-workers",
        "oauth",
        "google-oauth",
        "remote-mcp"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "src",
        "tsconfig.json"
    ],
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "prepare": "tsc"
    },
    "dependencies": {
        "@cloudflare/workers-oauth-provider": "^0.4.0",
        "agents": "^0.12.3"
    },
    "peerDependencies": {
        "@modelcontextprotocol/sdk": "^1.0.0"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20250404.0",
        "@modelcontextprotocol/sdk": "^1.0.0",
        "typescript": "^5.4.0"
    }
}
